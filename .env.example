# Lire REMPLIR-ENV.md pour les explications et un exemple DuckDNS concret.
# Ce modèle attend TROIS noms DNS distincts pointant vers la MÊME IP publique.
# Remplacer exemple.fr et 192.0.2.10 avant de continuer.


# Nom local du projet Docker. Ce n’est pas un domaine. Garder cette valeur.
COMPOSE_PROJECT_NAME=matric-poc-prod

# Identité définitive du serveur et suffixe des comptes @alice:ce-nom. SANS https://.
MATRIX_DOMAIN=matrix.exemple.fr

# Adresse HTTPS de l’API Matrix. Même nom que MATRIX_DOMAIN, AVEC https://.
SYNAPSE_URL=https://matrix.exemple.fr

# Adresse HTTPS de la page web à communiquer aux collègues. Nom distinct de Matrix.
ELEMENT_URL=https://element.exemple.fr

# Adresse HTTPS des services d’appel. Troisième nom distinct. Utilisée automatiquement.
RTC_URL=https://rtc.exemple.fr

# Nom du relais média. SANS https://. Ici reprendre le nom utilisé dans RTC_URL.
TURN_HOST=rtc.exemple.fr

# À REMPLACER : IPv4 PUBLIQUE de votre connexion, pas l’IP LAN ni l’IP Tailscale.
SERVER_IP=192.0.2.10

# Écouter sur toutes les interfaces IPv4 de la machine. Garder 0.0.0.0.
BIND_IP=0.0.0.0

# Port HTTP et validation du certificat. Conserver les ports ci-dessous.
HTTP_PORT=80
HTTPS_PORT=443

# Ports média LiveKit : TCP et plage UDP (valeurs sous 16383).
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_START=15000
LIVEKIT_UDP_END=15100

# Ports du relais TURN et plage UDP, à rediriger également sur la box.
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_UDP_START=15200
TURN_UDP_END=15300

# Le certificat public sera installé par python3 scripts/tls.py issue. Garder provided.
TLS_MODE=provided

# Images Docker : noms des logiciels et versions, pas des URL utilisateur. Garder pour le premier test.
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.163.0
ELEMENT_IMAGE=ghcr.io/element-hq/element-web:v1.12.31
JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:0.9.0
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.10
COTURN_IMAGE=coturn/coturn:4.18.0-r0
POSTGRES_IMAGE=postgres:16.10-alpine
CADDY_IMAGE=caddy:2.10.2-alpine

# Laisser vide : générés au premier rendu, jamais copiés depuis le POC.
POSTGRES_PASSWORD=
REGISTRATION_SHARED_SECRET=
MACAROON_SECRET=
FORM_SECRET=
LIVEKIT_KEY=
LIVEKIT_SECRET=
TURN_SECRET=
AS_TOKEN=
HS_TOKEN=
