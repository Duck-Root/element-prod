# Nginx installé sur CET hôte. Aucun conteneur Caddy/Nginx.
# Lire REMPLIR-ENV.md. Un seul domaine définitif pour tous les services web.
COMPOSE_PROJECT_NAME=matric-poc-prod

# Suffixe permanent des comptes, SANS https://. Remplacer exemple.fr.
MATRIX_DOMAIN=matrix.exemple.fr
# Les trois URL sont IDENTIQUES dans ce profil. AVEC https://, sans chemin.
SYNAPSE_URL=https://matrix.exemple.fr
ELEMENT_URL=https://matrix.exemple.fr
RTC_URL=https://matrix.exemple.fr
# TURN utilise le même nom, SANS https://.
TURN_HOST=matrix.exemple.fr

# IPv4 PUBLIQUE à remplacer. Ne pas renseigner l’IP LAN/Tailscale.
SERVER_IP=192.0.2.10
# Publication des ports MEDIA sur l’hôte. Les ports HTTP restent toujours loopback.
BIND_IP=0.0.0.0
# Ports de Nginx hôte, aucun mapping Docker sur ces ports.
HTTP_PORT=80
HTTPS_PORT=443

# Autres conteneurs du serveur : MariaDB, Password Pusher, alert-monitor, Vaultwarden.
# Le générateur refuse de publier un port TCP Matrix figurant dans cette liste.
# Adapter sur un autre serveur. Ne modifie ni ces applications ni leur pare-feu.
RESERVED_TCP_PORTS=3306,5100,8090,8443

# IP publiques de SORTIE du VPN et des bureaux, sans https://.
# Exemples de format : IPv4 seule ou IP/32. Laisser vide bloque l’administration.
ADMIN_VPN_IP=
ADMIN_OFFICE_IP=

# Ports HTTP de Docker : uniquement 127.0.0.1. Aucun NAT public vers ces ports.
SYNAPSE_HTTP_PORT=18008
ELEMENT_HTTP_PORT=18080
JWT_HTTP_PORT=18081
LIVEKIT_HTTP_PORT=17880
KETESA_HTTP_PORT=18082

# Média : conserver les mêmes valeurs dans les règles NAT/pare-feu.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_START=15000
LIVEKIT_UDP_END=15100
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_UDP_START=15200
TURN_UDP_END=15300

# Certificat public géré sur le serveur et copié avec scripts/tls.py install.
TLS_MODE=provided

# Images épinglées ; Ketesa est construit pour /admin.
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.163.0
ELEMENT_IMAGE=ghcr.io/element-hq/element-web:v1.12.31
JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:0.9.0
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.10
COTURN_IMAGE=coturn/coturn:4.18.0-r0
POSTGRES_IMAGE=postgres:16.10-alpine
KETESA_IMAGE=ghcr.io/etkecc/ketesa:v1.5.1-subpath-admin

# Secrets : laisser vide au premier rendu, ne pas réinitialiser ensuite.
POSTGRES_PASSWORD=
REGISTRATION_SHARED_SECRET=
MACAROON_SECRET=
FORM_SECRET=
LIVEKIT_KEY=
LIVEKIT_SECRET=
TURN_SECRET=
AS_TOKEN=
HS_TOKEN=
